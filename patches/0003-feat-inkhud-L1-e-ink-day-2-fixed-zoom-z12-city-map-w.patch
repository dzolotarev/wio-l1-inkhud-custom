+                if (hasDist)
+                    fromUs += "  ";
+                snprintf(buf, sizeof(buf), "brg %.0f deg", brg);
+                fromUs += buf;
+            }
+            if (!fromUs.empty())
+                bullet("From us " + fromUs);
+        }
+    }
+
+    l.clear();
+    if (node->bitfield & NODEINFO_BITFIELD_VIA_MQTT_MASK)
+        l += "MQTT  ";
+    if (node->bitfield & NODEINFO_BITFIELD_HAS_RF_HEAR_MASK)
+        l += "RF  ";
+    if (node->bitfield & NODEINFO_BITFIELD_HAS_XEDDSA_SIGNED_MASK)
+        l += "XEDDSA  ";
+    if (nodeInfoLiteHasIsUnmessagable(node) && nodeInfoLiteIsUnmessagable(node))
+        l += "no-msg";
+    if (!l.empty())
+        bullet("Flags " + l);
+
+    // Footer: controls + position in list
+    l = to_string((unsigned)(cursor + 1)) + "/" + to_string((unsigned)cards.size());
+    setFont(fontSmall);
+    printAt(0, height() - fontSmall.lineHeight(), "OK:back Hold:msg");
+    printAt(width() - 1, height() - fontSmall.lineHeight(), l, RIGHT, BOTTOM);
 }
 
+// -- Input --
+void InkHUD::HeardApplet::ensureCursorVisible()
+{
+    const uint16_t vis = lastVisibleCards == 0 ? 1 : lastVisibleCards;
+    if (cursor >= (uint16_t)(scrollOffset + vis))
+        scrollOffset = cursor - vis + 1;
+    else if (cursor < scrollOffset)
+        scrollOffset = cursor;
+}
+
+void InkHUD::HeardApplet::onNavUp()
+{
+    if (cards.empty())
+        return;
+    if (cursor > 0)
+        cursor--;
+    if (mode == MODE_LIST)
+        ensureCursorVisible();
+    requestUpdate();
+}
+
+void InkHUD::HeardApplet::onNavDown()
+{
+    if (cards.empty())
+        return;
+    if ((uint16_t)(cursor + 1) < cards.size())
+        cursor++;
+    if (mode == MODE_LIST)
+        ensureCursorVisible();
+    requestUpdate();
+}
+
+void InkHUD::HeardApplet::onButtonShortPress()
+{
+    if (mode == MODE_DETAIL)
+        closeDetail();
+    else
+        openDetail();
+}
+
+void InkHUD::HeardApplet::onExitShort() // User button: back from the detail card
+{
+    if (mode == MODE_DETAIL)
+        closeDetail();
+}
+
+// Hold center in the detail card: compose a message straight to this node
+void InkHUD::HeardApplet::onButtonLongPress()
+{
+    if (mode != MODE_DETAIL || cursor >= cards.size())
+        return;
+
+    const NodeNum dest = cards.at(cursor).nodeNum;
+    mode = MODE_LIST;                             // after sending we land on the list, not the card
+    setInputsSubscribed(EXIT_SHORT | BUTTON_LONG, false);
+    inkhud->openMenu();
+    MenuApplet *menu = static_cast<MenuApplet *>(inkhud->getSystemApplet("Menu"));
+    if (menu)
+        menu->messageTo(dest);
+}
 #endif
