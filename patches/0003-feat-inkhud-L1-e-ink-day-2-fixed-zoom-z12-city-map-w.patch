+#ifdef MESHTASTIC_INCLUDE_INKHUD
+
+#include "./MeshMapApplet.h"
+
+#include "graphics/niche/InkHUD/Applets/System/Menu/MenuApplet.h"
+
+using namespace NicheGraphics;
+
+static constexpr uint8_t ALL_MAP_INPUTS =
+    InkHUD::Applet::NAV_UP | InkHUD::Applet::NAV_DOWN | InkHUD::Applet::NAV_LEFT | InkHUD::Applet::NAV_RIGHT |
+    InkHUD::Applet::BUTTON_LONG;
+
+void InkHUD::MeshMapApplet::onActivate()
+{
+    setInputsSubscribed(ALL_MAP_INPUTS, true);
+}
+
+void InkHUD::MeshMapApplet::onDeactivate()
+{
+    setInputsSubscribed(ALL_MAP_INPUTS, false);
+    resetPan();
+}
+
+// Half a screen per step; the auto-repeat makes holding a smooth scroll
+void InkHUD::MeshMapApplet::onNavUp()
+{
+    panBy(0.0f, viewHeightMeters() * 0.5f);
+    requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+}
+
+void InkHUD::MeshMapApplet::onNavDown()
+{
+    panBy(0.0f, -viewHeightMeters() * 0.5f);
+    requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+}
+
+void InkHUD::MeshMapApplet::onNavLeft()
+{
+    panBy(-viewWidthMeters() * 0.5f, 0.0f);
+    requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+}
+
+void InkHUD::MeshMapApplet::onNavRight()
+{
+    panBy(viewWidthMeters() * 0.5f, 0.0f);
+    requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+}
+
+// Hold center: write to the node nearest screen center; plain menu otherwise
+void InkHUD::MeshMapApplet::onButtonLongPress()
+{
+    const NodeNum dest = nodeNearestCenter(30.0f);
+    if (dest == 0) {
+        inkhud->openMenu(); // no node under the cursor: behave like any other applet
+        return;
+    }
+
+    inkhud->openMenu();
+    MenuApplet *menu = static_cast<MenuApplet *>(inkhud->getSystemApplet("Menu"));
+    if (menu)
+        menu->messageTo(dest);
+}
+#endif
