+            l += " ";
+            l += buf;
+        }
+    }
+    bullet(l);
+
+    if (node->last_heard != 0) {
+        l = "Heard " + timeAgo(node->last_heard) + " ago";
+        std::string clock = getTimeString(node->last_heard);
