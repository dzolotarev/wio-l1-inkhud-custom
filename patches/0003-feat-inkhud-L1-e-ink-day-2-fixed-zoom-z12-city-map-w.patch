+    drawHeader(head);
+
+    const int16_t headerDivY = getHeaderHeight() - 1;
+    int16_t y = headerDivY + 4;
+
+    // Big name, wrapping if it is longer than a line
+    setFont(fontMedium);
+    std::string longName = EmojiSubs::cleanNodeName(node->long_name);
+    if (longName.empty())
+        longName = hexifyNodeNum(num);
+    printWrapped(0, y, width() - 2, longName);
+    y += (int16_t)getWrappedTextHeight(0, width() - 2, longName) + 3;
+
+    // Facts as wrapping bullets: nothing gets cut off at the screen edge
+    setFont(fontSmall);
+    const uint16_t bulletIndent = getTextWidth("- ");
+    const uint16_t bulletW = width() - bulletIndent - 2;
+    auto bullet = [&](const std::string &text) {
+        printAt(0, y, "-");
+        printWrapped(bulletIndent, y, bulletW, text);
+        const uint32_t h = getWrappedTextHeight(bulletIndent, bulletW, text);
+        y += (int16_t)max(h, (uint32_t)fontSmall.lineHeight()) + 2;
+    };
+
+    char buf[64];
+    std::string l;
+
+    snprintf(buf, sizeof(buf), "!%08x", (unsigned)num);
+    l = buf;
+    if (node->channel != 0)
+        l += "  Ch" + to_string((unsigned)node->channel);
+    if (node->public_key.size > 0) {
+        snprintf(buf, sizeof(buf), "  PKC %02x%02x", node->public_key.bytes[0], node->public_key.bytes[1]);
