+std::string InkHUD::HeardApplet::timeAgo(uint32_t epochSec)
+{
+    int32_t ago = (int32_t)(getTime() - epochSec);
+    if (ago < 0)
+        ago = 0;
+    if (ago < 60)
+        return "now";
+    if (ago < 3600)
+        return to_string((unsigned)(ago / 60)) + "m";
+    if (ago < 86400)
+        return to_string((unsigned)(ago / 3600)) + "h";
+    return to_string((unsigned)(ago / 86400)) + "d";
+}
+
+void InkHUD::HeardApplet::drawDetail()
+{
+    if (cursor >= cards.size())
+        cursor = 0;
+    const NodeNum num = cards.at(cursor).nodeNum;
+    meshtastic_NodeInfoLite *node = nodeDB->getMeshNode(num);
+    if (!node) {
+        populateFromNodeDB(); // Node vanished; back to a sane list
+        requestUpdate();
+        return;
+    }
+
+    // Header: short name (cleaned)
+    std::string head = EmojiSubs::cleanNodeName(node->short_name);
+    if (head.empty())
