     for (Marker m : markers) {
         int16_t x = X(0.5) + (int16_t)(m.eastMeters * metersToPx);
         int16_t y = Y(0.5) - (int16_t)(m.northMeters * metersToPx);
@@ -463,6 +501,27 @@ void InkHUD::MapApplet::onRender(bool full)
         int boxSize = fontSmall.lineHeight() + 2; // scale with font so digit fits
         int radius = max(2, boxSize / 6);
 
+        // Short-name label in a white strip; skipped when it would collide with another label
+        if (m.shortName[0]) {
+            setFont(fontSmall);
+            const int16_t labelW = getTextWidth(m.shortName);
+            const int16_t labelH = fontSmall.lineHeight();
+            int16_t lx = x + boxSize / 2 + 3;
+            if (lx + labelW > width() - 2)
+                lx = x - boxSize / 2 - 3 - labelW;
+            const int16_t ly = y - labelH / 2;
+            bool collides = false;
+            for (const LabelBox &b : labelBoxes) {
+                if (lx < b.x + b.w + 2 && lx + labelW > b.x - 2 && ly < b.y + b.h + 2 && ly + labelH > b.y - 2)
+                    collides = true;
+            }
+            if (lx >= 2 && ly >= 2 && ly + labelH <= height() - 2 && !collides) {
+                fillRect(lx - 1, ly - 1, labelW + 2, labelH + 1, WHITE);
+                printAt(lx, ly, m.shortName, LEFT, TOP);
+                labelBoxes.push_back({lx, ly, labelW, (int16_t)labelH});
+            }
+        }
+
         // White halo background
         fillRoundedRect(x, y, boxSize + (outlinePad * 2), boxSize + (outlinePad * 2), radius + 1, WHITE);
 
@@ -1105,7 +1164,10 @@ void InkHUD::MapApplet::calculateAllMarkers()
