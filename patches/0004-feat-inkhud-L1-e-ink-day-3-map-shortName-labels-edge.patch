+// Bad GPS fixes (or a mesh centroid dragged far away) anchor the view outside our baked tile
+// grid, which silently loses the basemap. Snap the center back to the grid's midpoint.
+void InkHUD::MapApplet::clampCenterToTiles()
+{
+    const int zoom = tileZoomLevel();
+    int minTx = INT32_MAX, maxTx = -1, minTy = INT32_MAX, maxTy = -1;
+    for (int i = 0; i < map_tile_count; i++) {
+        if (tileZoomAt(i) != zoom)
+            continue;
+        const int tx = tileTxAt(i), ty = tileTyAt(i);
+        minTx = min(minTx, tx);
+        maxTx = max(maxTx, tx);
+        minTy = min(minTy, ty);
+        maxTy = max(maxTy, ty);
+    }
+    if (maxTx < 0)
+        return;
+
+    const float worldPx = 256.0f * (float)(1 << zoom);
+    const float sinLat = sinf(latCenter * DEG_TO_RAD);
+    const float gpxX = ((lngCenter + 180.0f) / 360.0f) * worldPx;
+    const float gpxY = (0.5f - logf((1.0f + sinLat) / (1.0f - sinLat)) / (4.0f * M_PI)) * worldPx;
+    // Center may roam only as far as keeps the full window covered by tiles
+    const float clX = constrain(gpxX, (float)minTx * 256.0f + width() * 0.5f, (float)(maxTx + 1) * 256.0f - width() * 0.5f);
+    const float clY = constrain(gpxY, (float)minTy * 256.0f + height() * 0.5f, (float)(maxTy + 1) * 256.0f - height() * 0.5f);
+    if (clX == gpxX && clY == gpxY)
+        return;
+
+    lngCenter = clX / worldPx * 360.0f - 180.0f;
+    latCenter = atanf(sinhf(M_PI * (1.0f - 2.0f * clY / worldPx))) / DEG_TO_RAD;
+}
+
 // Draw tiles centered on latCenter/lngCenter. Falls back to the nearest available zoom if
 // no tiles exist at exactly zoom (upsamples), enabling smooth zoom steps.
 void InkHUD::MapApplet::drawMapTileBackground(int zoom)
@@ -398,6 +430,8 @@ void InkHUD::MapApplet::onRender(bool full)
         lngCenter += panEastMeters / (111320.0f * cosf(latCenter * DEG_TO_RAD));
     }
 
