+};
+
+static constexpr size_t tableCount = sizeof(table) / sizeof(table[0]);
+
+static const char *lookup(uint32_t cp)
+{
+    size_t lo = 0, hi = tableCount;
+    while (lo < hi) {
+        size_t mid = (lo + hi) / 2;
+        if (table[mid].cp < cp)
+            lo = mid + 1;
+        else if (table[mid].cp > cp)
+            hi = mid;
+        else
+            return table[mid].text;
+    }
+    return nullptr;
+}
+
+// Decode one UTF-8 sequence at pos. Returns false on malformed / truncated input.
+static bool decode(const std::string &s, size_t pos, size_t &len, uint32_t &cp)
+{
+    unsigned char b = s[pos];
+    if (b < 0x80) {
+        len = 1;
+        cp = b;
+        return true;
+    }
+    size_t need;
+    if ((b & 0xE0) == 0xC0) {
+        need = 1;
+        cp = b & 0x1F;
+    } else if ((b & 0xF0) == 0xE0) {
+        need = 2;
+        cp = b & 0x0F;
+    } else if ((b & 0xF8) == 0xF0) {
+        need = 3;
+        cp = b & 0x07;
+    } else
+        return false;
+    if (pos + need > s.size() - 1)
+        return false; // truncated
+    len = need + 1;
+    for (size_t k = 1; k < len; k++) {
+        unsigned char c = s[pos + k];
+        if ((c & 0xC0) != 0x80)
+            return false;
+        cp = (cp << 6) | (c & 0x3F);
+    }
+    return true;
+}
+
+static bool isEmojiRange(uint32_t cp)
+{
+    return (cp >= 0x1F000 && cp <= 0x1FAFF) || (cp >= 0x2600 && cp <= 0x27BF) || (cp >= 0x2B00 && cp <= 0x2BFF);
+}
+
+std::string EmojiSubs::cleanNodeName(const std::string &in)
+{
+    std::string out;
+    std::string firstEmojiName;
+    out.reserve(in.size());
+
+    size_t i = 0;
+    const size_t n = in.size();
+    while (i < n) {
+        size_t len;
+        uint32_t cp;
+        if (!decode(in, i, len, cp)) {
+            out += in[i]; // invalid byte: keep, parse() will deal with it as before
+            i++;
+            continue;
+        }
+        const size_t start = i;
+        i += len;
+
+        if (cp == 0xFE0F || cp == 0xFE0E || cp == 0x200D || (cp >= 0x1F3FB && cp <= 0x1F3FF))
+            continue; // pure decoration
+        if (isEmojiRange(cp)) {
+            if (firstEmojiName.empty()) {
+                const char *r = lookup(cp);
+                if (r)
+                    firstEmojiName = r;
+            }
+            continue; // emoji are cut from names
+        }
+        out.append(in, start, len);
+    }
+
+    // Trim surrounding spaces
+    const size_t b = out.find_first_not_of(' ');
+    const size_t e = out.find_last_not_of(' ');
+    if (b == std::string::npos)
+        out.clear();
+    else
+        out = out.substr(b, e - b + 1);
+
+    // Name was pure emoji: show the first emoji's text name instead of an empty card
+    if (out.empty())
+        return firstEmojiName;
+    return out;
+}
+
+std::string EmojiSubs::apply(const std::string &in, bool dropUnknown)
+{
+    InkHUD *ih = InkHUD::getInstance();
+    if (!ih || !ih->persistence)
+        return in;
+    if (!ih->persistence->settings.optionalFeatures.emojiText)
+        return in;
+
+    // Fast path: plain ascii passes through untouched
+    bool anyHigh = false;
+    for (char c : in) {
+        if ((unsigned char)c >= 0x80) {
+            anyHigh = true;
+            break;
+        }
+    }
+    if (!anyHigh)
+        return in;
+
+    std::string out;
+    out.reserve(in.size());
+
+    size_t i = 0;
+    const size_t n = in.size();
+    while (i < n) {
+        size_t len;
+        uint32_t cp;
+        if (!decode(in, i, len, cp)) {
+            out += in[i]; // byte of something we don't speak: pass through unchanged
+            i++;
+            continue;
+        }
+
+        // Variation selectors and skin-tone modifiers are noise on a text terminal: drop them
+        if (cp == 0xFE0F || cp == 0xFE0E || (cp >= 0x1F3FB && cp <= 0x1F3FF)) {
+            i += len;
+            continue;
+        }
+        // ZWJ glues emoji into sequences; render the glue as '+' (man+woman+girl)
+        if (cp == 0x200D) {
+            out += '+';
+            i += len;
+            continue;
+        }
+        // Regional-indicator pairs become the two-letter country code (flag -> "DE")
+        if (cp >= 0x1F1E6 && cp <= 0x1F1FF) {
+            size_t len2;
+            uint32_t cp2;
+            if (i + len < n && decode(in, i + len, len2, cp2) && cp2 >= 0x1F1E6 && cp2 <= 0x1F1FF) {
+                out += (char)('A' + (cp - 0x1F1E6));
+                out += (char)('A' + (cp2 - 0x1F1E6));
+                i += len + len2;
+                continue;
+            }
+            out.append(in, i, len);
+            i += len;
+            continue;
+        }
+
+        const char *r = lookup(cp);
+        if (r)
+            out += r;
+        else if (dropUnknown && isEmojiRange(cp))
+            ; // unknown emoji-range codepoint: drop silently (node names)
+        else
+            out.append(in, i, len); // unknown: keep original bytes (prior behavior)
+        i += len;
+    }
+    return out;
+}
+} // namespace NicheGraphics::InkHUD
