+#pragma once
+
+#include "configuration.h"
+
+#include <string>
+
+namespace NicheGraphics::InkHUD
+
+{
+// Replace the most common emoji codepoints with short ascii text, so that they survive the
+// monochrome bitmap fonts (which have no glyph beyond WIN1251 and draw "??" boxes instead).
+// Gated by settings.optionalFeatures.emojiText; apply() is a no-op when the toggle is off.
+class EmojiSubs {
+  public:
+    // Replace known emoji codepoints with ascii text. With dropUnknown=true, unknown emoji-range
+    // codepoints are deleted instead of passed through — for short fields like node names where a
+    // row of "??" boxes is uglier than the missing character.
+    static std::string apply(const std::string &utf8, bool dropUnknown = false);
+
+    // Sanitize a node name: drop all emoji, trim surrounding spaces.
+    // If nothing textual remains but the name contained emoji, return the first emoji's
+    // text name ("bot", "antenna"); if that fails too, return empty (caller falls back to id).
+    // Always active (independent of the Emoji as Text setting, which covers message bodies).
+    static std::string cleanNodeName(const std::string &utf8);
+};
+} // namespace NicheGraphics::InkHUD
