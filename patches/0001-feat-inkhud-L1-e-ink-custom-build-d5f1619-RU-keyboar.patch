+// Aux (physical user) button: if a system applet currently owns input (menu, keyboard),
+// let it dismiss; if the active applet wants the click (e.g. Tetris pause), give it that;
+// otherwise cycle to the next applet.
+void InkHUD::InkHUD::auxAppletSwitch()
+{
+    // D13 "user button": dismiss an open system UI (menu/keyboard), otherwise leave the
+    // current applet. A foreground applet's BUTTON_SHORT (e.g. Tetris pause) is intentionally
+    // NOT routed here - it stays on the joystick-center press (shortpress()), so the user
+    // button always doubles as an "exit / next applet" control.
+
+    // Match the audio/power side effects every other Events.cpp handler plays.
+    playChirp();
+    powerFSM.trigger(EVENT_INPUT);
+
+    for (SystemApplet *sa : systemApplets) {
+        if (sa->handleInput) {
+            sa->onExitShort();
+            return;
+        }
+    }
+
+    nextApplet();
+}
+
 // Cycle the previous user applet to the foreground
 // Only activated applets are cycled
 // If user has a multi-applet layout, the applets will cycle on the "focused tile"
