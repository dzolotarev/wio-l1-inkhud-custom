+    // Russian (ЙЦУКЕН) legacy layout. Letters are WIN1251 bytes (the font encoding);
+    // handleLegacyInput converts them to UTF-8 before injecting. The ESC slot ('\x1b')
+    // is the RU/EN toggle. To fit 30 letters, '!' ',' '.' '?' become ж б ю х; ъ, ё, э
+    // are omitted. Punctuation (, . ?) is available by switching back to EN.
+    const char legacyKeysRU[LEGACY_KBD_KEY_COUNT] = {
+        '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '\b',                                  // row 0
+        '\xe9', '\xf6', '\xf3', '\xea', '\xe5', '\xed', '\xe3', '\xf8', '\xf9', '\xe7', '\n',      // row 1: й ц у к е н г ш щ з
+        '\xf4', '\xfb', '\xe2', '\xe0', '\xef', '\xf0', '\xee', '\xeb', '\xe4', '\xe6', ' ',       // row 2: ф ы в а п р о л д ж
+        '\xff', '\xf7', '\xf1', '\xec', '\xe8', '\xf2', '\xfc', '\xe1', '\xfe', '\xf5', '\x1b'     // row 3: я ч с м и т ь б ю х
+    };
+
+    const char *activeLegacyKeys() const { return ruLayout ? legacyKeysRU : legacyKeys; }
+
     const uint16_t legacyKeyWidths[LEGACY_KBD_KEY_COUNT] = {
