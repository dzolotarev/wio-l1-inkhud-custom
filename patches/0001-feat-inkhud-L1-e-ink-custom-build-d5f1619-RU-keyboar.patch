+
+void InkHUD::ThreadedMessageApplet::onNavUp()
+{
+    // Clamp to this channel's own message count: scrolling must stop at the oldest
+    // message, never run past it into an empty screen (the store spans all channels/DMs).
+    int channelCount = 0;
+    for (const auto &m : messageStore.getLiveMessages())
+        if (m.type == MessageType::BROADCAST && m.channelIndex == channelIndex)
+            channelCount++;
+
+    const int maxScroll = channelCount - 1; // Keep at least the oldest message visible
+    if ((int)scrollOffset < maxScroll) {
+        scrollOffset++;
+        requestUpdate();
+    }
+}
+
+void InkHUD::ThreadedMessageApplet::onNavDown()
+{
+    if (scrollOffset > 0) {
+        scrollOffset--;
+        requestUpdate();
+    }
+}
+
+void InkHUD::ThreadedMessageApplet::onForeground()
+{
+    Applet::onForeground();
+    scrollOffset = 0;
 }
 
