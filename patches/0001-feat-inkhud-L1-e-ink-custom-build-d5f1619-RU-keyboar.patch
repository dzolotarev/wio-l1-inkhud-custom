diff --git a/src/graphics/niche/InkHUD/Applets/Bases/NodeList/NodeListApplet.cpp b/src/graphics/niche/InkHUD/Applets/Bases/NodeList/NodeListApplet.cpp
index 69dbf61af..1b75a21dd 100644
--- a/src/graphics/niche/InkHUD/Applets/Bases/NodeList/NodeListApplet.cpp
+++ b/src/graphics/niche/InkHUD/Applets/Bases/NodeList/NodeListApplet.cpp
@@ -14,6 +14,32 @@ InkHUD::NodeListApplet::NodeListApplet(const char *name) : MeshModule(name)
     // We only need to be promiscuous in order to hear NodeInfo, apparently. See NodeInfoModule
     // For all other packets, we manually act as if isPromiscuous=false, in wantPacket
     MeshModule::isPromiscuous = true;
+
+    // Joystick up/down scroll the list; left/right still cycle applets (unsubscribed)
+    setInputsSubscribed(NAV_UP | NAV_DOWN, true);
+}
+
+void InkHUD::NodeListApplet::onNavUp()
+{
+    if (scrollOffset > 0) {
+        scrollOffset--;
+        requestUpdate();
+    }
+}
+
+void InkHUD::NodeListApplet::onNavDown()
+{
+    const int maxScroll = (int)cards.size() - (int)lastVisibleCards;
+    if ((int)scrollOffset < maxScroll) {
+        scrollOffset++;
+        requestUpdate();
+    }
+}
+
+void InkHUD::NodeListApplet::onForeground()
+{
+    Applet::onForeground();
+    scrollOffset = 0;
 }
 
