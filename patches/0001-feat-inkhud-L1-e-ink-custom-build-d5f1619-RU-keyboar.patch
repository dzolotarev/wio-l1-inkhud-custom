+#ifdef MESHTASTIC_INCLUDE_INKHUD
+
+#include "./TetrisApplet.h"
+
+#include <algorithm>
+
+#include "buzz/buzz.h"
+
+using namespace NicheGraphics;
+
+// Piece definitions: four cells inside an NxN box, rotation 0.
+// Rotations are derived by (x,y) -> (N-1-y, x), applied rot times.
+struct TetrisShape {
+    uint8_t n;                     // Bounding box size
+    int8_t cells[4][2];            // (x,y) at rotation 0
+};
+static const TetrisShape shapes[7] = {
+    /* I */ {4, {{1, 0}, {1, 1}, {1, 2}, {1, 3}}},
+    /* O */ {2, {{0, 0}, {1, 0}, {0, 1}, {1, 1}}},
+    /* T */ {3, {{1, 0}, {0, 1}, {1, 1}, {2, 1}}},
+    /* S */ {3, {{1, 0}, {2, 0}, {0, 1}, {1, 1}}},
+    /* Z */ {3, {{0, 0}, {1, 0}, {1, 1}, {2, 1}}},
+    /* L */ {3, {{2, 0}, {0, 1}, {1, 1}, {2, 1}}},
+    /* J */ {3, {{0, 0}, {0, 1}, {1, 1}, {2, 1}}},
+};
+
+// Cell of a piece's bounding box, after rotation
+static void rotatedCell(uint8_t type, uint8_t rot, uint8_t i, int8_t &x, int8_t &y)
+{
+    const TetrisShape &s = shapes[type];
+    x = s.cells[i][0];
+    y = s.cells[i][1];
+    for (uint8_t r = 0; r < (rot % 4); r++) {
+        int8_t nx = (int8_t)(s.n - 1) - y;
+        int8_t ny = x;
+        x = nx;
+        y = ny;
+    }
+}
+
+bool InkHUD::TetrisApplet::fits(uint8_t type, uint8_t rot, int8_t px, int8_t py)
+{
+    for (uint8_t i = 0; i < 4; i++) {
+        int8_t cx, cy;
+        rotatedCell(type, rot, i, cx, cy);
+        int8_t bx = px + cx;
+        int8_t by = py + cy;
+        if (bx < 0 || bx >= (int8_t)boardCols || by < 0 || by >= (int8_t)rows)
+            return false;
+        if (grid[by][bx])
+            return false;
+    }
+    return true;
+}
+
+void InkHUD::TetrisApplet::resetGame()
+{
+    memset(grid, 0, sizeof(grid));
+    score = 0;
+    lines = 0;
+    level = 0;
+    gameOver = false;
+    paused = false;
+    nextType = pickPiece();
+    spawn(); // Seed the first active piece; also flags gameOver if the fresh board can't hold it
+}
+
+uint8_t InkHUD::TetrisApplet::pickPiece()
+{
+    return (uint8_t)random(0, 7);
+}
+
+void InkHUD::TetrisApplet::spawn()
+{
+    curType = nextType;
+    nextType = pickPiece();
+    curRot = 0;
+    curX = 3;
+    curY = 0;
+    if (!fits(curType, curRot, curX, curY)) {
+        gameOver = true;
+        play4ClickDown();
+    }
+}
+
+void InkHUD::TetrisApplet::lockPiece()
+{
+    for (uint8_t i = 0; i < 4; i++) {
+        int8_t cx, cy;
+        rotatedCell(curType, curRot, i, cx, cy);
+        int8_t bx = curX + cx;
+        int8_t by = curY + cy;
+        if (by >= 0 && by < (int8_t)rows && bx >= 0 && bx < (int8_t)boardCols)
+            grid[by][bx] = 1;
+    }
+    clearLines();
+    spawn();
+}
+
+void InkHUD::TetrisApplet::clearLines()
+{
+    uint16_t cleared = 0;
+    int8_t r = (int8_t)rows - 1;
+    while (r >= 0) {
+        bool full = true;
+        for (uint8_t c = 0; c < boardCols; c++) {
+            if (!grid[r][c]) {
+                full = false;
+                break;
+            }
+        }
+        if (!full) {
+            r--;
+            continue;
+        }
+        // Drop everything above this row down one
+        for (uint8_t c = 0; c < boardCols; c++) {
+            for (int8_t y = r; y > 0; y--)
+                grid[y][c] = grid[y - 1][c];
+            grid[0][c] = 0;
+        }
+        cleared++;
+        // Stay on row r: after the shift it holds the row that was above, which
+        // must be re-checked or consecutive full lines are missed (one per lock).
+    }
+    if (cleared == 0)
+        return;
+
+    static const uint16_t table[5] = {0, 100, 300, 500, 800};
+    score += table[cleared] * (level + 1);
+    lines += cleared;
+    level = (lines / 10 > 9) ? 9 : (lines / 10);
+
+    if (cleared >= 4)
+        playComboTune();
+    else if (cleared >= 2)
+        playStartMelody();
+    else
+        playBoop();
+}
+
+void InkHUD::TetrisApplet::stepDown(bool soft)
+{
+    if (fits(curType, curRot, curX, curY + 1)) {
+        curY++;
+        if (soft)
+            score += 1;
+    } else {
+        lockPiece();
+    }
+}
+
+void InkHUD::TetrisApplet::hardDropInfo(int8_t *ghostY)
+{
+    int8_t y = curY;
+    while (fits(curType, curRot, curX, y + 1))
+        y++;
+    *ghostY = y;
+}
+
+uint32_t InkHUD::TetrisApplet::gravityIntervalMs()
+{
+    uint32_t ms = 700 - (uint32_t)level * 50;
+    return (ms < 220) ? 220 : ms;
+}
+
+// Size the playfield to the tile: pick a square cell that fills the available area,
+// then derive the live row count so the well uses (almost) the whole screen.
+// Portrait (height > width, the L1 default at rotation=1): the well spans nearly the
+// full width and the HUD moves into a bottom strip. Landscape: well left, HUD right.
+void InkHUD::TetrisApplet::configureBoard()
+{
+    const int16_t headerH = Applet::getHeaderHeight();
+    const int16_t availH = height() - headerH - 2;
+    const bool portrait = height() > width();
+
+    int16_t c;
+    int r;
+    if (portrait) {
+        c = (width() - 6) / boardCols; // well nearly full width
+        if (c > 14)
+            c = 14;
+        if (c < 4)
+            c = 4;
+        const int16_t hudStrip = fontSmall.lineHeight() * 2 + 7; // bottom strip: stats line + hint line
+        r = (availH - hudStrip) / c;
+        if (r > MAX_ROWS)
+            r = MAX_ROWS;
+        if (r < 10)
+            r = 10;
+        const int16_t cH = (availH - hudStrip) / r;
+        if (cH < c)
+            c = cH;
+        if (c < 4)
+            c = 4;
+    } else {
+        int16_t hudReserve = (int16_t)(width() * 28 / 100);
+        const int16_t hudMin = fontSmall.lineHeight() * 5;
+        if (hudReserve < hudMin)
+            hudReserve = hudMin;
+        int16_t availWBudget = width() - hudReserve - 6;
+        if (availWBudget < (int16_t)(boardCols * 4))
+            availWBudget = boardCols * 4;
+
+        c = availWBudget / boardCols;
+        if (c < 4)
+            c = 4;
+        const int16_t cellByW = c;
+        r = availH / cellByW;
+        if (r > MAX_ROWS)
+            r = MAX_ROWS;
+        if (r < 11)
+            r = 11;
+        const int16_t cellByH = availH / r;
+        if (cellByH < c)
+            c = cellByH;
+    }
+    if (c > 16)
+        c = 16;
+    if (c < 4)
+        c = 4;
+
+    rows = (uint8_t)r;
+    cell = (uint8_t)c;
+
+    // Drop any settled blocks that fell outside a now-shrunken well.
+    for (uint8_t rr = rows; rr < MAX_ROWS; rr++)
+        for (uint8_t cc = 0; cc < boardCols; cc++)
+            grid[rr][cc] = 0;
+}
+
+// -- OSThread: gravity --
+int32_t InkHUD::TetrisApplet::runOnce()
+{
+    if (!isActive() || !isForeground() || paused || gameOver)
+        return OSThread::interval;
+
+    stepDown(false);
+    requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+    OSThread::setIntervalFromNow(gravityIntervalMs());
+    return OSThread::interval;
+}
+
+// -- Input --
+void InkHUD::TetrisApplet::onNavLeft()
+{
+    if (paused || gameOver)
+        return;
+    if (fits(curType, curRot, curX - 1, curY)) {
+        curX--;
+        playClick();
+        requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+    }
+}
+
+void InkHUD::TetrisApplet::onNavRight()
+{
+    if (paused || gameOver)
+        return;
+    if (fits(curType, curRot, curX + 1, curY)) {
+        curX++;
+        playClick();
+        requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+    }
+}
+
+void InkHUD::TetrisApplet::onNavUp() // Rotate, with tiny wall kicks
+{
+    if (paused || gameOver)
+        return;
+    uint8_t rot = (curRot + 1) % 4;
+    static const int8_t kicks[5] = {0, -1, 1, -2, 2};
+    for (int8_t k : kicks) {
+        if (fits(curType, rot, (int8_t)(curX + k), curY)) {
+            curRot = rot;
+            curX += k;
+            playChirp();
+            requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+            return;
+        }
+    }
+}
+
+void InkHUD::TetrisApplet::onNavDown() // Soft drop
+{
+    if (paused || gameOver)
+        return;
+    stepDown(true);
+    OSThread::setIntervalFromNow(gravityIntervalMs()); // Reset gravity clock after manual step
+    requestUpdate(Drivers::EInk::UpdateTypes::FAST);
+}
+
+void InkHUD::TetrisApplet::onButtonShortPress() // Pause / restart
+{
+    if (gameOver) {
+        resetGame();
+        awaitingStart = false;
+        OSThread::setIntervalFromNow(gravityIntervalMs());
+        requestUpdate();
+        return;
+    }
+    paused = !paused;
+    if (!paused)
+        awaitingStart = false; // The click that un-parks a fresh board starts the game
+    playBoop();
+    requestUpdate();
+}
+
+// -- Lifecycle --
+void InkHUD::TetrisApplet::onActivate()
+{
+    setInputsSubscribed(NAV_UP | NAV_DOWN | NAV_LEFT | NAV_RIGHT | BUTTON_SHORT, true);
+}
+
+void InkHUD::TetrisApplet::onDeactivate()
+{
+    setInputsSubscribed(NAV_UP | NAV_DOWN | NAV_LEFT | NAV_RIGHT | BUTTON_SHORT, false);
+    OSThread::disable();
+}
+
+void InkHUD::TetrisApplet::onForeground()
+{
+    configureBoard();
+    if (!booted) {
+        resetGame();
+        booted = true;
+    }
+    // Don't start moving on tab entry: park the board until the user clicks to start.
+    paused = true;
+    awaitingStart = true;
+    OSThread::enabled = true;
+    OSThread::setIntervalFromNow(gravityIntervalMs());
+}
+
+void InkHUD::TetrisApplet::onBackground()
+{
+    OSThread::disable();
+    paused = true; // Leaving the tab stops the game; entry always waits for a start click
+}
+
+void InkHUD::TetrisApplet::onShutdown()
+{
+    paused = true; // Resume paused after reboot (board itself isn't persisted)
+}
+
+// -- Rendering --
+void InkHUD::TetrisApplet::onRender(bool full)
+{
+    drawHeader("Tetris");
+
+    configureBoard();
+    const int16_t headerH = Applet::getHeaderHeight();
+
+    const int16_t wellW = cell * boardCols;
+    const int16_t wellH = cell * rows;
+    const bool portrait = height() > width();
+    if (portrait) {
+        wellL = (width() - wellW) / 2; // nearly full width, centered
+        wellT = headerH + 1;          // top-aligned; HUD lives in the bottom strip
+    } else {
+        wellL = 2;
+        wellT = headerH + 1 + (height() - headerH - 2 - wellH) / 2; // center vertically
+    }
+    if (wellT < headerH + 1)
+        wellT = headerH + 1;
+
+    // Well: white field, black frame
+    fillRect(wellL - 1, wellT - 1, wellW + 3, wellH + 3, WHITE);
+    drawRect(wellL - 1, wellT - 1, wellW + 2, wellH + 2, BLACK);
+    drawRect(wellL, wellT, wellW, wellH, BLACK);
+
+    auto blockX = [&](int8_t bx) { return wellL + (int16_t)bx * cell; };
+    auto blockY = [&](int8_t by) { return wellT + (int16_t)by * cell; };
+
+    // Settled blocks: solid with a bright pixel top-left (chunky retro look)
+    for (uint8_t r = 0; r < rows; r++) {
+        for (uint8_t c = 0; c < boardCols; c++) {
+            if (!grid[r][c])
+                continue;
+            int16_t x = blockX(c), y = blockY(r);
+            fillRect(x + 1, y + 1, cell - 1, cell - 1, BLACK);
+            drawPixel(x + 1, y + 1, WHITE);
+        }
+    }
+
+    if (!gameOver) {
+        // Ghost: dashed outline where the piece would land
+        int8_t gy;
+        hardDropInfo(&gy);
+        for (uint8_t i = 0; i < 4; i++) {
+            int8_t cx, cy;
+            rotatedCell(curType, curRot, i, cx, cy);
+            int16_t x = blockX(curX + cx), y = blockY(gy + cy);
+            for (int16_t px = 0; px < cell; px += 2) {
+                drawPixel(x + px, y + 1, BLACK);
+                drawPixel(x + px, y + cell - 1, BLACK);
+            }
+            for (int16_t py = 0; py < cell; py += 2) {
+                drawPixel(x + 1, y + py, BLACK);
+                drawPixel(x + cell - 1, y + py, BLACK);
+            }
+        }
+
+        // Active piece: solid with white center dot
+        for (uint8_t i = 0; i < 4; i++) {
+            int8_t cx, cy;
+            rotatedCell(curType, curRot, i, cx, cy);
+            int16_t x = blockX(curX + cx), y = blockY(curY + cy);
+            fillRect(x + 1, y + 1, cell - 1, cell - 1, BLACK);
+            drawPixel(x + 1, y + 1, WHITE);
+            if (cell >= 5)
+                drawPixel(x + cell / 2, y + cell / 2, WHITE);
+        }
+    }
+
+    // HUD. Portrait: compact strip under the well. Landscape: column to the right of the well.
+    if (portrait) {
+        const int16_t hudT = wellT + wellH + 3;
+        if (hudT + fontSmall.lineHeight() <= height() - 1) {
+            setFont(fontSmall);
+            const std::string stats = "Sc " + to_string(score) + "  Lv " + to_string(level) + "  Ln " + to_string(lines);
+            printAt(wellL, hudT, stats, LEFT, TOP);
+
+            // Next-piece preview, right-aligned in the strip
+            const int16_t pcell = 4;
+            const int16_t boxW = 4 * pcell + 3;
+            const int16_t bx = width() - boxW - 2;
+            const int16_t by = hudT - 1;
+            drawRect(bx, by, boxW, boxW + 1, BLACK);
+            for (uint8_t i = 0; i < 4; i++) {
+                int8_t cx, cy;
+                rotatedCell(nextType, 0, i, cx, cy);
+                fillRect(bx + 1 + cx * pcell, by + 1 + cy * pcell, pcell - 1, pcell - 1, BLACK);
+                drawPixel(bx + 1 + cx * pcell, by + 1 + cy * pcell, WHITE);
+            }
+
+            const int16_t cy2 = hudT + fontSmall.lineHeight() + 3;
+            if (cy2 + fontSmall.lineHeight() <= height() - 1) {
+                std::string hint = "Tap: pause  Btn: quit";
+                if (getTextWidth(hint) > wellW)
+                    hint = "Tap:pause  Btn:quit";
+                printAt(wellL, cy2, hint, LEFT, TOP);
+            }
+        }
+    } else {
+        const int16_t hudL = wellL + wellW + 6;
+        const bool hudFits = (hudL < (int16_t)(width() - fontMedium.lineHeight() * 4));
+        if (hudFits) {
+            int16_t y = wellT;
+            setFont(fontSmall);
+            printAt(hudL, y, "Score", LEFT, TOP);
+            y += fontSmall.lineHeight();
+            setFont(fontMedium);
+            printAt(hudL, y, to_string(score), LEFT, TOP);
+            setFont(fontSmall);
+            y += fontMedium.lineHeight() + 2;
+            printAt(hudL, y, "Lvl ", LEFT, TOP);
+            printAt(hudL + getTextWidth("Lvl "), y, to_string(level), LEFT, TOP);
+            y += fontSmall.lineHeight();
+            printAt(hudL, y, "Lines ", LEFT, TOP);
+            printAt(hudL + getTextWidth("Lines "), y, to_string(lines), LEFT, TOP);
+
+            y += fontSmall.lineHeight() + 3;
+            printAt(hudL, y, "Next", LEFT, TOP);
+
+            // Next-piece preview
+            y += fontSmall.lineHeight();
+            const int16_t pcx = hudL + 1, pcy = y + 1;
+            const uint8_t pcell = 4;
+            drawRect(pcx - 1, pcy - 1, 4 * pcell + 3, 4 * pcell + 3, BLACK);
+            for (uint8_t i = 0; i < 4; i++) {
+                int8_t cx, cy;
+                rotatedCell(nextType, 0, i, cx, cy);
+                fillRect(pcx + cx * pcell + 1, pcy + cy * pcell + 1, pcell - 1, pcell - 1, BLACK);
+                drawPixel(pcx + cx * pcell + 1, pcy + cy * pcell + 1, WHITE);
+            }
+
+            // Controls hint, in whatever slack remains below the preview
+            y += 4 * pcell + 5;
+            if (y + fontSmall.lineHeight() < height() - 2)
+                printAt(hudL, y, "Tap: pause", LEFT, TOP);
+            y += fontSmall.lineHeight();
+            if (y + fontSmall.lineHeight() < height() - 2)
+                printAt(hudL, y, "Btn: quit", LEFT, TOP);
+        }
+    }
+
+    // Overlays
+    if (paused && !gameOver) {
+        setFont(fontMedium);
+        const char *title = awaitingStart ? "READY" : "PAUSED";
+        const int16_t bw = std::min((int16_t)(width() - 4), std::max((int16_t)100, (int16_t)(getTextWidth(title) + 16)));
+        const int16_t extra = awaitingStart ? fontSmall.lineHeight() + 6 : 0;
+        const int16_t bh = fontMedium.lineHeight() + 14 + extra;
+        const int16_t bx = width() / 2 - bw / 2;
+        const int16_t by = height() / 2 - bh / 2;
+        fillRect(bx, by, bw, bh, WHITE);
+        drawRect(bx, by, bw - 1, bh - 1, BLACK);
+        if (awaitingStart) {
+            printAt(width() / 2, by + (bh - extra) / 2, title, CENTER, MIDDLE);
+            setFont(fontSmall);
+            printAt(width() / 2, by + bh - fontSmall.lineHeight() - 4, "Click: start", CENTER, TOP);
+        } else {
+            printAt(width() / 2, by + bh / 2, title, CENTER, MIDDLE);
+        }
+    } else if (gameOver) {
+        setFont(fontMedium);
+        const int16_t bw = std::min((int16_t)(width() - 4),
+                                    std::max((int16_t)130, (int16_t)(getTextWidth("GAME OVER") + 16)));
+        const int16_t bh = fontMedium.lineHeight() + fontSmall.lineHeight() + 18;
+        const int16_t bx = width() / 2 - bw / 2;
+        const int16_t by = height() / 2 - bh / 2;
+        fillRect(bx, by, bw, bh, WHITE);
+        drawRect(bx, by, bw - 1, bh - 1, BLACK);
+        printAt(width() / 2, by + bh / 2 - fontSmall.lineHeight() / 2, "GAME OVER", CENTER, MIDDLE);
+        setFont(fontSmall);
+        printAt(width() / 2, by + bh - fontSmall.lineHeight() - 4, "Tap: new game", CENTER, TOP);
+    }
+}
+
+#endif
diff --git a/src/graphics/niche/InkHUD/Applets/User/Tetris/TetrisApplet.h b/src/graphics/niche/InkHUD/Applets/User/Tetris/TetrisApplet.h
new file mode 100644
index 000000000..8665bbf07
